APP_ENV=development
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=customer_records
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=3600
DEV_OTP_DELIVERY=true
DEV_OTP_FILE=./work/dev-otp.txt
HISTORY_LIMIT=20
